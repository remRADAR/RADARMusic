# Server-only analytics storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

# Optional Spotify Web API metadata enrichment
SPOTIFY_CLIENT_ID=replace-with-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-spotify-client-secret

# Optional email delivery via Resend
RESEND_API_KEY=replace-with-resend-key
NOTIFY_FROM_EMAIL=notifications@example.com

# Optional SMS delivery via Twilio
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
